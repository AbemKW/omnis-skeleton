{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"C:\\Program Files\\Git\\bin\\bash.exe\" .claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(& \"C:\\Program Files\\Git\\bin\\bash.exe\" .claude/hooks/*)",
      "WebSearch",
      "WebFetch",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(dir)",
      "Bash(dir *)",
      "Bash(cat *)",
      "Bash(type *)",
      "Bash(pwd)",
      "Bash(tree)",
      "Bash(tree *)",
      "Bash(Get-Content *)",
      "Bash(Get-ChildItem *)",
      "Bash(Get-Location)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(where *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(more *)",
      "Bash(Select-String *)",
      "Bash(whoami)",
      "Bash(hostname)",
      "Bash(date *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(jq *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(gh auth status)",
      "Bash(gh repo view *)"
    ]
  }
}
