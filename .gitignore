# Raw meeting audio files (large binary assets — do not commit)
knowledge/sources/meetings/raw/*.m4a
knowledge/sources/meetings/raw/*.mp3
knowledge/sources/meetings/raw/*.wav

# Document vault: binaries and extracts stay local; only the ledger is tracked
knowledge/documents/*
!knowledge/documents/_index.md

